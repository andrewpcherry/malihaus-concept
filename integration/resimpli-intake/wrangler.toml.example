# Example Cloudflare Workers settings for the intake handler. Copy to
# wrangler.toml, fill in, and deploy with `wrangler deploy`. Not deployed yet.
# Any host that runs Web-standard fetch handlers will work the same way.
name = "malihaus-lead-intake"
main = "worker.js"
compatibility_date = "2026-11-01"

[[kv_namespaces]]
binding = "LEADS_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
ALLOWED_ORIGINS = "https://www.malihaus.com"
RESIMPLI_PIPELINE_ID = ""
RESIMPLI_MAIN_STATUS_ID = ""
RESIMPLI_MARKET_ID_FLORIDA = ""
RESIMPLI_MARKET_ID_OHIO = ""
RESIMPLI_CAMPAIGN_ID_FLORIDA = ""
RESIMPLI_CAMPAIGN_ID_OHIO = ""
# Optional
# RESIMPLI_TAG_IDS_FLORIDA = "id1,id2"
# RESIMPLI_TAG_IDS_OHIO = "id1,id2"
# RESIMPLI_LEAD_ID_PATH = "data._id"
# RESIMPLI_AUTH_PREFIX = "Bearer "

# The API key is a secret, never a var and never committed:
#   wrangler secret put RESIMPLI_API_KEY
